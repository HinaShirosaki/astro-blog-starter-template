---
import BaseHead from '../components/BaseHead.astro';

export const prerender = false;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Private Valentine Login" description="Login to view the private Valentine's gallery" />
  </head>
  <body class="login-page">
    <main class="shell">
      <section class="card">
        <p class="eyebrow">Private space</p>
        <h1>Valentine Albums</h1>
        <p class="lead">Sign in to continue.</p>

        <div class="accounts">
          <p><strong>Author:</strong> author / authorLove2026!</p>
          <p><strong>Visitor:</strong> visitor / visitorLove2026!</p>
        </div>

        <form id="login-form">
          <label>
            Username
            <input id="username" required autocomplete="username" />
          </label>
          <label>
            Password
            <input id="password" type="password" required autocomplete="current-password" />
          </label>
          <button type="submit">Continue</button>
          <p id="error-message" role="alert"></p>
        </form>
      </section>
    </main>
  </body>
</html>

<style>
  :root { color-scheme: light; }
  .login-page {
    min-height: 100vh;
    display: grid;
    place-items: center;
    background: radial-gradient(circle at top, #ffe6ef 0, #ffd7e6 42%, #f6f5f7 100%);
    color: #1d1d1f;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', sans-serif;
  }
  .shell { width: min(460px, calc(100% - 2rem)); }
  .card {
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid rgba(255, 192, 211, 0.6);
    border-radius: 28px;
    padding: 2rem;
    backdrop-filter: blur(20px);
    box-shadow: 0 24px 50px rgba(247, 132, 177, 0.2);
  }
  .eyebrow { text-transform: uppercase; letter-spacing: .08em; font-size: .75rem; color: #c94b83; margin-bottom: .4rem; }
  h1 { margin: 0; font-size: 2rem; font-weight: 700; }
  .lead { margin: .45rem 0 1rem; color: #555; }
  .accounts { background: #fff6fa; border: 1px solid #ffd4e5; border-radius: 16px; padding: .85rem 1rem; margin-bottom: 1rem; }
  .accounts p { margin: .2rem 0; font-size: .92rem; }
  form { display: grid; gap: .9rem; }
  label { display: grid; gap: .4rem; font-size: .92rem; color: #444; }
  input {
    border-radius: 12px;
    border: 1px solid #ebc4d6;
    background: #fff;
    padding: .78rem .9rem;
    font-size: .95rem;
  }
  button {
    border: 0;
    border-radius: 999px;
    padding: .78rem 1rem;
    background: linear-gradient(120deg, #ff7eb2, #f35f93);
    color: #fff;
    font-weight: 600;
    cursor: pointer;
  }
  #error-message { min-height: 1.2rem; color: #bd3556; margin: 0; font-size: .9rem; }
</style>

<script>
  const form = document.querySelector('#login-form');
  const errorMessage = document.querySelector('#error-message');

  const pemToArrayBuffer = (pem) => {
    const b64 = pem.replace(/-----BEGIN PUBLIC KEY-----|-----END PUBLIC KEY-----|\s/g, '');
    const bin = atob(b64);
    const bytes = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i += 1) bytes[i] = bin.charCodeAt(i);
    return bytes.buffer;
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorMessage.textContent = 'Authenticating...';

    const username = document.querySelector('#username')?.value ?? '';
    const password = document.querySelector('#password')?.value ?? '';

    try {
      const keyResponse = await fetch('/api/auth/public-key');
      const { publicKey } = await keyResponse.json();
      const importedKey = await crypto.subtle.importKey(
        'spki',
        pemToArrayBuffer(publicKey),
        { name: 'RSA-OAEP', hash: 'SHA-256' },
        false,
        ['encrypt'],
      );

      const encrypted = await crypto.subtle.encrypt(
        { name: 'RSA-OAEP' },
        importedKey,
        new TextEncoder().encode(JSON.stringify({ username, password })),
      );

      const payload = btoa(String.fromCharCode(...new Uint8Array(encrypted)));
      const response = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ payload }),
      });

      if (!response.ok) {
        const body = await response.json().catch(() => ({ message: 'Authentication failed.' }));
        throw new Error(body.message);
      }

      window.location.href = '/';
    } catch (error) {
      errorMessage.textContent = error instanceof Error ? error.message : 'Unable to login.';
    }
  });
</script>
