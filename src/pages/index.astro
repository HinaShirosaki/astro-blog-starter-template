---
import BaseHead from '../components/BaseHead.astro';
import { defaultAlbums } from '../data/albums';
import { AUTH_ROLE_COOKIE } from '../lib/auth';

export const prerender = false;

const albumsJson = JSON.stringify(defaultAlbums);
const role = Astro.cookies.get(AUTH_ROLE_COOKIE)?.value ?? 'visitor';
const isAuthor = role === 'author';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Valentine's Albums" description="Private Valentine's Day memory albums" />
  </head>
  <body class="page">
    <main>
      <section class="hero">
        <h1>💘 Our Valentine's Collection</h1>
        <p>Browse your albums as visitor or manage them as author.</p>
        <p class="role-badge">Signed in as: <strong>{role}</strong></p>
        <button id="logout">Lock site</button>
      </section>

      <section>
        <h2>Albums</h2>
        <div id="album-grid" class="album-grid"></div>
      </section>

      {
        isAuthor && (
          <section class="manager">
            <h2>Album Manager (Author)</h2>
            <p>Upload images, add map details, and create or edit albums.</p>
            <form id="album-form">
              <input id="albumId" type="hidden" />
              <input id="title" placeholder="Album title" required />
              <input id="description" placeholder="Description" required />
              <input id="locationLabel" placeholder="Location label (e.g. Paris, France)" required />
              <div class="map-grid">
                <input id="lat" type="number" step="0.0001" placeholder="Latitude" required />
                <input id="lng" type="number" step="0.0001" placeholder="Longitude" required />
              </div>
              <label for="photos">Photos for new album (optional when editing):</label>
              <input id="photos" type="file" accept="image/*" multiple />
              <iframe
                id="picker-map"
                title="Google map preview"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                src="https://maps.google.com/maps?q=22.3,114.17&z=4&output=embed"
              ></iframe>
              <button type="submit">Save Album</button>
            </form>
          </section>
        )
      }
    </main>

    <script type="application/json" id="default-albums" set:html={albumsJson}></script>
    <script is:inline define:vars={{ isAuthor }}>
      const defaults = JSON.parse(document.querySelector('#default-albums')?.textContent || '[]');
      const storeKey = 'valentine-custom-albums';
      const albumGrid = document.querySelector('#album-grid');

      const getAlbums = () => {
        const custom = JSON.parse(localStorage.getItem(storeKey) || '[]');
        return [...defaults, ...custom];
      };

      const saveCustomAlbums = (albums) => {
        localStorage.setItem(storeKey, JSON.stringify(albums));
      };

      const toAlbumLink = (id) => `/albums/${encodeURIComponent(id)}`;

      const renderAlbums = () => {
        albumGrid.innerHTML = '';
        getAlbums().forEach((album) => {
          const card = document.createElement('article');
          card.className = 'card';
          card.innerHTML = `
            <a href="${toAlbumLink(album.id)}" class="album-link">
              <img src="${album.cover}" alt="${album.title}" />
              <div class="content">
                <strong>${album.title}</strong>
                <p>${album.description}</p>
              </div>
            </a>
            ${isAuthor ? `<button class="edit" data-album-id="${album.id}">Edit</button>` : ''}
          `;
          albumGrid.append(card);
        });
      };

      document.querySelector('#logout')?.addEventListener('click', async () => {
        await fetch('/api/auth/logout', { method: 'POST' });
        window.location.href = '/login';
      });

      const form = document.querySelector('#album-form');

      const updateMapPreview = () => {
        const lat = document.querySelector('#lat')?.value;
        const lng = document.querySelector('#lng')?.value;
        if (!lat || !lng) return;
        const map = document.querySelector('#picker-map');
        map.src = `https://maps.google.com/maps?q=${lat},${lng}&z=12&output=embed`;
      };

      document.querySelector('#lat')?.addEventListener('change', updateMapPreview);
      document.querySelector('#lng')?.addEventListener('change', updateMapPreview);

      albumGrid?.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof HTMLButtonElement) || !target.classList.contains('edit')) return;

        const albumId = target.dataset.albumId;
        const album = getAlbums().find((item) => item.id === albumId);
        if (!album) return;

        document.querySelector('#albumId').value = album.id;
        document.querySelector('#title').value = album.title;
        document.querySelector('#description').value = album.description;
        document.querySelector('#locationLabel').value = album.locationLabel;
        document.querySelector('#lat').value = album.lat;
        document.querySelector('#lng').value = album.lng;
        updateMapPreview();
        form?.scrollIntoView({ behavior: 'smooth' });
      });

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const current = JSON.parse(localStorage.getItem(storeKey) || '[]');
        const editingId = document.querySelector('#albumId').value;
        const existing = getAlbums().find((album) => album.id === editingId);

        const files = Array.from(document.querySelector('#photos').files || []);
        const photos = await Promise.all(
          files.map(async (file, index) => {
            const src = await new Promise((resolve) => {
              const reader = new FileReader();
              reader.onload = () => resolve(reader.result);
              reader.readAsDataURL(file);
            });

            return { src, alt: `${file.name}-${index + 1}` };
          }),
        );

        const album = {
          id: editingId || crypto.randomUUID(),
          title: document.querySelector('#title').value,
          description: document.querySelector('#description').value,
          locationLabel: document.querySelector('#locationLabel').value,
          lat: Number(document.querySelector('#lat').value),
          lng: Number(document.querySelector('#lng').value),
          cover: photos[0]?.src || existing?.cover,
          photos: photos.length ? photos : existing?.photos || [],
        };

        if (!album.cover || !album.photos.length) {
          window.alert('Please upload at least one photo when creating a new album.');
          return;
        }

        const index = current.findIndex((item) => item.id === album.id);
        if (index >= 0) current[index] = album;
        else current.push(album);

        saveCustomAlbums(current);
        form.reset();
        document.querySelector('#albumId').value = '';
        renderAlbums();
      });

      renderAlbums();
    </script>
  </body>
</html>

<style>
  .page { background: linear-gradient(180deg,#fff0f5,#ffd7e4 45%,#fff); min-height: 100vh; color: #52152f; }
  main { width: min(1120px, calc(100% - 2rem)); margin: 0 auto; padding: 2rem 0 4rem; display: grid; gap: 1.5rem; }
  .hero { background: linear-gradient(120deg,#ff6ca0,#ff3d80); color: #fff; border-radius: 20px; padding: 2rem; box-shadow: 0 12px 30px rgba(196,18,85,.28); }
  .role-badge { margin-bottom: 1rem; }
  #logout { border: 0; border-radius: 999px; padding: .65rem 1rem; cursor: pointer; }
  .album-grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill,minmax(320px,1fr)); }
  .card { background: #fff; border-radius: 14px; overflow: hidden; border: 1px solid #ffd0df; box-shadow: 0 10px 20px rgba(128,32,71,.1); }
  .album-link { color: inherit; text-decoration: none; display: block; }
  .card img { width: 100%; height: 260px; object-fit: cover; border-radius: 0; }
  .card .content { padding: 1rem; }
  .edit { margin: 0 1rem 1rem; border-radius: 10px; border: 1px solid #f4a6c0; padding: .65rem .8rem; cursor: pointer; }
  .manager { background: #fff; border: 1px solid #ffd0df; border-radius: 18px; padding: 1rem; }
  form { display: grid; gap: .8rem; }
  input, button { padding: .75rem; border-radius: 10px; border: 1px solid #f4a6c0; }
  .map-grid { display: grid; gap: .8rem; grid-template-columns: 1fr 1fr; }
  #picker-map { height: 320px; width: 100%; border-radius: 12px; border: 1px solid #f4a6c0; }
</style>
