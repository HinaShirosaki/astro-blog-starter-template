---
import BaseHead from '../components/BaseHead.astro';
import { defaultAlbums } from '../data/albums';
import { AUTH_ROLE_COOKIE } from '../lib/auth';

export const prerender = false;

const albumsJson = JSON.stringify(defaultAlbums);
const role = Astro.cookies.get(AUTH_ROLE_COOKIE)?.value ?? 'visitor';
const isAuthor = role === 'author';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Valentine's Albums" description="Private Valentine's Day memory albums" />
  </head>
  <body class="page">
    <main>
      <section class="hero glass">
        <p class="eyebrow">Shared memories</p>
        <h1>Valentine Albums</h1>
        <p class="subtitle">Apple-inspired clean layout with a soft pink tone.</p>
        <div class="hero-actions">
          <p class="role">Signed in as <strong>{role}</strong></p>
          <button id="logout">Sign out</button>
        </div>
      </section>

      <section>
        <h2>Albums</h2>
        <div id="album-grid" class="album-grid"></div>
      </section>

      {
        isAuthor && (
          <section class="manager glass">
            <h2>Album Manager</h2>
            <p>Create or edit albums. Drop a pin on the map to set the location.</p>
            <form id="album-form">
              <input id="albumId" type="hidden" />
              <input id="title" placeholder="Album title" required />
              <input id="description" placeholder="Description" required />
              <input id="locationLabel" placeholder="Location label" required />
              <input id="lat" type="hidden" />
              <input id="lng" type="hidden" />
              <label for="photos">Photos (optional for edit)</label>
              <input id="photos" type="file" accept="image/*" multiple />
              <div id="picker-map" class="picker-map" aria-label="Pick location by dropping a pin">
                <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/8/80/World_map_-_low_resolution.svg/1280px-World_map_-_low_resolution.svg.png" alt="World map picker" />
                <span id="pin">📍</span>
              </div>
              <small id="map-help">Tap/click the map to drop a pin. The pin location will be saved.</small>
              <button type="submit" class="primary">Save Album</button>
            </form>
          </section>
        )
      }
    </main>

    <script type="application/json" id="default-albums" set:html={albumsJson}></script>
    <script is:inline define:vars={{ isAuthor }}>
      const defaults = JSON.parse(document.querySelector('#default-albums')?.textContent || '[]');
      const storeKey = 'valentine-custom-albums';
      const albumGrid = document.querySelector('#album-grid');
      const mapPicker = document.querySelector('#picker-map');
      const pin = document.querySelector('#pin');

      const getAlbums = () => {
        const custom = JSON.parse(localStorage.getItem(storeKey) || '[]');
        return [...defaults, ...custom];
      };

      const saveCustomAlbums = (albums) => localStorage.setItem(storeKey, JSON.stringify(albums));
      const toAlbumLink = (id) => `/albums/${encodeURIComponent(id)}`;

      const positionFromLatLng = (lat, lng) => ({
        x: Math.max(0, Math.min(1, (lng + 180) / 360)),
        y: Math.max(0, Math.min(1, (90 - lat) / 180)),
      });

      const latLngFromPosition = (x, y) => ({
        lat: Number((90 - y * 180).toFixed(6)),
        lng: Number((x * 360 - 180).toFixed(6)),
      });

      const setPin = (lat, lng) => {
        const latInput = document.querySelector('#lat');
        const lngInput = document.querySelector('#lng');
        if (latInput) latInput.value = String(lat);
        if (lngInput) lngInput.value = String(lng);

        if (!pin) return;
        const pos = positionFromLatLng(lat, lng);
        pin.style.left = `${pos.x * 100}%`;
        pin.style.top = `${pos.y * 100}%`;
        pin.classList.add('visible');
      };

      const initPickerMap = () => {
        if (!isAuthor || !mapPicker || !pin) return;

        mapPicker.addEventListener('click', (event) => {
          const rect = mapPicker.getBoundingClientRect();
          const x = (event.clientX - rect.left) / rect.width;
          const y = (event.clientY - rect.top) / rect.height;
          const { lat, lng } = latLngFromPosition(x, y);
          setPin(lat, lng);
        });
      };

      const renderAlbums = () => {
        albumGrid.innerHTML = '';
        getAlbums().forEach((album) => {
          const card = document.createElement('article');
          card.className = 'card';
          card.innerHTML = `
            <a href="${toAlbumLink(album.id)}" class="album-link">
              <img src="${album.cover}" alt="${album.title}" />
              <div class="content">
                <strong>${album.title}</strong>
                <p>${album.description}</p>
              </div>
            </a>
            ${isAuthor ? `<button class="edit" data-album-id="${album.id}">Edit</button>` : ''}
          `;
          albumGrid.append(card);
        });
      };

      document.querySelector('#logout')?.addEventListener('click', async () => {
        await fetch('/api/auth/logout', { method: 'POST' });
        window.location.href = '/login';
      });

      const form = document.querySelector('#album-form');

      albumGrid?.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof HTMLButtonElement) || !target.classList.contains('edit')) return;

        const albumId = target.dataset.albumId;
        const album = getAlbums().find((item) => item.id === albumId);
        if (!album) return;

        document.querySelector('#albumId').value = album.id;
        document.querySelector('#title').value = album.title;
        document.querySelector('#description').value = album.description;
        document.querySelector('#locationLabel').value = album.locationLabel;
        setPin(album.lat, album.lng);
        form?.scrollIntoView({ behavior: 'smooth' });
      });

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const current = JSON.parse(localStorage.getItem(storeKey) || '[]');
        const editingId = document.querySelector('#albumId').value;
        const existing = getAlbums().find((album) => album.id === editingId);

        const files = Array.from(document.querySelector('#photos').files || []);
        const photos = await Promise.all(
          files.map(async (file, index) => {
            const src = await new Promise((resolve) => {
              const reader = new FileReader();
              reader.onload = () => resolve(reader.result);
              reader.readAsDataURL(file);
            });
            return { src, alt: `${file.name}-${index + 1}` };
          }),
        );

        const lat = Number(document.querySelector('#lat').value);
        const lng = Number(document.querySelector('#lng').value);

        const album = {
          id: editingId || crypto.randomUUID(),
          title: document.querySelector('#title').value,
          description: document.querySelector('#description').value,
          locationLabel: document.querySelector('#locationLabel').value,
          lat,
          lng,
          cover: photos[0]?.src || existing?.cover,
          photos: photos.length ? photos : existing?.photos || [],
        };

        if (!album.cover || !album.photos.length) {
          window.alert('Please upload at least one photo when creating a new album.');
          return;
        }

        if (Number.isNaN(lat) || Number.isNaN(lng)) {
          window.alert('Please drop a pin on the map to set the album location.');
          return;
        }

        const index = current.findIndex((item) => item.id === album.id);
        if (index >= 0) current[index] = album;
        else current.push(album);

        saveCustomAlbums(current);
        form.reset();
        document.querySelector('#albumId').value = '';
        document.querySelector('#lat').value = '';
        document.querySelector('#lng').value = '';
        pin?.classList.remove('visible');
        renderAlbums();
      });

      renderAlbums();
      initPickerMap();
    </script>
  </body>
</html>

<style>
  :root { color-scheme: light; }
  .page {
    min-height: 100vh;
    background: linear-gradient(180deg, #fff1f6 0%, #f5f5f7 55%, #ffffff 100%);
    color: #1d1d1f;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', sans-serif;
  }
  main { width: min(1120px, calc(100% - 2rem)); margin: 0 auto; padding: 2rem 0 4rem; display: grid; gap: 1.5rem; }
  .glass {
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(255, 190, 215, 0.65);
    border-radius: 28px;
    box-shadow: 0 24px 50px rgba(245, 143, 183, 0.18);
    backdrop-filter: blur(18px);
  }
  .hero { padding: 2rem; }
  .eyebrow { text-transform: uppercase; letter-spacing: .08em; color: #cd4e87; font-size: .75rem; margin: 0 0 .35rem; }
  h1 { margin: 0; font-size: clamp(2rem, 5vw, 3rem); }
  .subtitle { margin: .55rem 0 1rem; color: #555; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .8rem; }
  .role { margin: 0; background: #fff6fa; border: 1px solid #ffd3e4; border-radius: 999px; padding: .45rem .8rem; }
  #logout, .primary { border: 0; border-radius: 999px; padding: .65rem 1rem; background: #1d1d1f; color: #fff; cursor: pointer; }
  h2 { margin: .2rem 0 .8rem; font-size: 1.6rem; }
  .album-grid { display: grid; gap: 1.2rem; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); }
  .card { overflow: hidden; border-radius: 22px; background: #fff; border: 1px solid #f0d4df; box-shadow: 0 16px 24px rgba(0, 0, 0, .06); }
  .album-link { color: inherit; text-decoration: none; display: block; }
  .card img { width: 100%; height: 300px; object-fit: cover; display: block; }
  .content { padding: 1rem 1rem .6rem; }
  .content strong { font-size: 1.1rem; }
  .content p { color: #555; margin-top: .45rem; }
  .edit { margin: 0 1rem 1rem; border: 1px solid #e7b4cb; border-radius: 12px; background: #fff8fb; padding: .55rem .8rem; cursor: pointer; }
  .manager { padding: 1.3rem; }
  form { display: grid; gap: .8rem; }
  input, button { padding: .72rem .8rem; border-radius: 12px; border: 1px solid #e8c3d3; }
  label { color: #555; font-size: .92rem; }
  .picker-map {
    position: relative;
    height: 320px;
    width: 100%;
    border-radius: 16px;
    border: 1px solid #e8c3d3;
    overflow: hidden;
    cursor: crosshair;
    background: #fff;
  }
  .picker-map img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
    pointer-events: none;
  }
  #pin {
    position: absolute;
    transform: translate(-50%, -100%);
    font-size: 1.5rem;
    display: none;
    pointer-events: none;
  }
  #pin.visible { display: block; }
  #map-help { color: #666; }
</style>
