---
import BaseHead from '../../components/BaseHead.astro';
import { defaultAlbums } from '../../data/albums';

export const prerender = false;

const defaultsJson = JSON.stringify(defaultAlbums);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Album Details" description="Individual album page" />
  </head>
  <body class="page">
    <main class="album-page">
      <a href="/" class="back">← Back to albums</a>
      <section class="header glass">
        <p class="eyebrow">Album details</p>
        <h1 id="album-title"></h1>
        <p id="album-description"></p>
      </section>
      <iframe id="album-map" title="Album location on Google Maps" loading="lazy"></iframe>
      <section id="photos" class="photos"></section>
    </main>

    <script type="application/json" id="default-albums" set:html={defaultsJson}></script>
    <script is:inline>
      const defaults = JSON.parse(document.querySelector('#default-albums')?.textContent || '[]');
      const custom = JSON.parse(localStorage.getItem('valentine-custom-albums') || '[]');
      const albums = [...defaults, ...custom];
      const id = decodeURIComponent(window.location.pathname.split('/').pop() || '');
      const album = albums.find((item) => item.id === id);

      if (!album) {
        document.querySelector('#album-title').textContent = 'Album not found';
      } else {
        document.querySelector('#album-title').textContent = album.title;
        document.querySelector('#album-description').textContent = `${album.description} — ${album.locationLabel}`;
        document.querySelector('#album-map').src = `https://maps.google.com/maps?q=${album.lat},${album.lng}&z=12&output=embed`;
        document.querySelector('#photos').innerHTML = album.photos
          .map((photo) => `<img src="${photo.src}" alt="${photo.alt}" />`)
          .join('');
      }
    </script>
  </body>
</html>

<style>
  .page {
    min-height: 100vh;
    background: linear-gradient(180deg, #fff0f6, #f5f5f7 50%, #fff);
    color: #1d1d1f;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', sans-serif;
  }
  .album-page { width: min(1120px, calc(100% - 2rem)); margin: 0 auto; padding: 2rem 0 3rem; }
  .back { display: inline-block; margin-bottom: 1rem; color: #c6427c; text-decoration: none; font-weight: 600; }
  .glass {
    background: rgba(255, 255, 255, 0.75);
    border: 1px solid rgba(255, 190, 215, 0.65);
    border-radius: 26px;
    box-shadow: 0 22px 44px rgba(245, 143, 183, 0.16);
    backdrop-filter: blur(18px);
  }
  .header { padding: 1.2rem 1.4rem; }
  .eyebrow { margin: 0 0 .4rem; color: #cd4e87; text-transform: uppercase; letter-spacing: .08em; font-size: .75rem; }
  #album-title { margin: 0; font-size: clamp(1.8rem, 4vw, 2.8rem); }
  #album-description { margin-top: .55rem; color: #555; }
  #album-map { width: 100%; height: 360px; border: 1px solid #f0d4df; border-radius: 20px; margin: 1rem 0 1.3rem; background: #fff; }
  .photos { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); }
  .photos img { width: 100%; height: 290px; object-fit: cover; border-radius: 18px; box-shadow: 0 10px 16px rgba(0,0,0,.07); }
</style>
