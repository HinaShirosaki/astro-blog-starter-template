---
import BaseHead from '../../components/BaseHead.astro';
import { defaultAlbums } from '../../data/albums';

export const prerender = false;

const defaultsJson = JSON.stringify(defaultAlbums);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Album Details" description="Individual album page" />
  </head>
  <body class="page">
    <main class="album-page">
      <a href="/" class="back">← Back to albums</a>
      <h1 id="album-title"></h1>
      <p id="album-description"></p>
      <iframe id="album-map" title="Album location on Google Maps" loading="lazy"></iframe>
      <section id="photos" class="photos"></section>
    </main>

    <script type="application/json" id="default-albums" set:html={defaultsJson}></script>
    <script is:inline>
      const defaults = JSON.parse(document.querySelector('#default-albums')?.textContent || '[]');
      const custom = JSON.parse(localStorage.getItem('valentine-custom-albums') || '[]');
      const albums = [...defaults, ...custom];
      const id = decodeURIComponent(window.location.pathname.split('/').pop() || '');
      const album = albums.find((item) => item.id === id);

      if (!album) {
        document.querySelector('#album-title').textContent = 'Album not found';
      } else {
        document.querySelector('#album-title').textContent = album.title;
        document.querySelector('#album-description').textContent = `${album.description} — ${album.locationLabel}`;
        document.querySelector('#album-map').src = `https://maps.google.com/maps?q=${album.lat},${album.lng}&z=12&output=embed`;
        document.querySelector('#photos').innerHTML = album.photos
          .map((photo) => `<img src="${photo.src}" alt="${photo.alt}" />`)
          .join('');
      }
    </script>
  </body>
</html>

<style>
  .page { background: #fff5f9; min-height: 100vh; color: #52152f; }
  .album-page { width: min(1080px, calc(100% - 2rem)); margin: 0 auto; padding: 2rem 0 3rem; }
  .back { display: inline-block; margin-bottom: 1rem; }
  #album-map { width: 100%; height: 340px; border: 1px solid #f4a6c0; border-radius: 12px; margin: 1rem 0 1.2rem; }
  .photos { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(300px,1fr)); }
  .photos img { width: 100%; height: 260px; object-fit: cover; border-radius: 12px; }
</style>
